# Frontend (Vite static build) -- build-time only. Local dev and
# `vite preview` need none of this: leave VITE_API_BASE_URL unset and the
# app calls same-origin /api through the Vite proxy.

# Bare origin of the live API. Set this in the frontend host's build
# environment variables for production. A blank or non-http(s) value is
# ignored and the app falls back to /api.
VITE_API_BASE_URL=https://<service>.onrender.com

# Build identity is picked up automatically from CF_PAGES_COMMIT_SHA on
# Cloudflare Pages and written into each HTML entry as
# <meta name="app-build-commit">. VITE_BUILD_COMMIT overrides it elsewhere.
# VITE_BUILD_COMMIT=

# Public source repository. THE ONLY PLACE this destination is configured:
# it drives both the "GitHub" item in the top navigation and the
# "Source and citation" row in Technical Documentation
# (web/src/components/AppShell.tsx).
#
# Leave it UNSET for any build whose visitors could not open the repository.
# Unset is the safe default and renders neither surface, so a production
# build never ships a dead or private link to an unauthenticated visitor.
# Set it, in the frontend host's build environment, only once a curated
# public repository exists at that URL.
# VITE_PUBLIC_REPO_URL=https://github.com/<org>/<repo>
