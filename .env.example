# Live API (FastAPI on Render). Copy to `.env` for a local run; on Render
# set these in the service's Environment tab. No secrets: every value is a
# public hostname or a mode string.

# development (default) keeps /docs, /redoc, /openapi.json; staging|production
# disable them. An unrecognised value is treated as production (fail safe).
TRACKC_APP_ENV=production

# Exact browser origin(s) allowed to call the API, comma-separated. No
# wildcard. Empty => no CORS middleware (same-origin local dev via the Vite
# proxy). In production this is the deployed frontend origin.
TRACKC_APP_CORS_ORIGINS=https://<project>.pages.dev

# Allowed Host header value(s) for the directly exposed service,
# comma-separated. Empty => the check is not installed. Set to the real
# Render hostname; a leading dot (".onrender.com") matches any subdomain.
TRACKC_APP_TRUSTED_HOSTS=<service>.onrender.com

# Optional build/release commit id for /api/version. Render already provides
# RENDER_GIT_COMMIT automatically, so this is only needed on hosts that do
# not. Never set a fabricated value.
# TRACKC_APP_COMMIT=
